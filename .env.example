# ==============================================================================
# PRAXIS SIMULATION PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure your secrets locally.
# Never commit your real .env file with secrets to Git.

# Server Port
PORT=8000

# Groq Frontier LLM API Key (for Dual-LLM Consensus Evaluation Engine)
# Sign up and obtain key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Supabase Cloud Database (for Cross-Device Real-Time Sync)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_publishable_anon_key
